# Normally generated for you by scripts/gen-env.sh. All values below are placeholders.
# Only SHA-256 hashes of the tokens go to the service:  printf %s 'your-token' | shasum -a 256
FRAUDSTREAM_AUTH_TOKENS=ingestor:INGEST:replace-me,analyst-1:ANALYST:replace-me,operator:ADMIN:replace-me
FRAUDSTREAM_INGEST_TOKEN=replace-me
FRAUDSTREAM_ANALYST_TOKEN=replace-me
FRAUDSTREAM_ADMIN_TOKEN=replace-me
GRAFANA_ADMIN_PASSWORD=replace-me
